From 18f292a00fc1bc48afaff8ee31b485514930eb68 Mon Sep 17 00:00:00 2001
From: FloatNote <noreply@anthropic.com>
Date: Sat, 15 Aug 2026 13:19:33 +0300
Subject: [PATCH] FloatNote patch: sticky scroll, selection stability, deeper
 scrollback
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

1. Set Terminal.userScrolling from scrollTo() so incoming output stops
   yanking the viewport to the bottom. The flag is honored by
   Terminal.scroll() but never set upstream — the view's identically-named
   property is a different variable.

2. Notify on scrollback trim (new TerminalDelegate.linesTrimmed, default
   no-op) and shift the selection by the same amount. start/end are line-ring
   indices, so without this the highlight walks down through the text while
   output streams — you select a line and copy a different one.

3. TerminalView.defaultScrollback, because upstream hardcodes TerminalOptions'
   500-line default and rebuilds options on every resize.

Adds linesBelowViewport / scrollToBottom() for the scroll-back pill.
---
 .../SwiftTerm/Apple/AppleTerminalView.swift   | 41 ++++++++++++++++++-
 Sources/SwiftTerm/Mac/MacTerminalView.swift   | 25 +++++++----
 Sources/SwiftTerm/SelectionService.swift      | 28 +++++++++++++
 Sources/SwiftTerm/Terminal.swift              | 22 ++++++++++
 4 files changed, 108 insertions(+), 8 deletions(-)

diff --git a/Sources/SwiftTerm/Apple/AppleTerminalView.swift b/Sources/SwiftTerm/Apple/AppleTerminalView.swift
index 2b50935..d4c7cce 100644
--- a/Sources/SwiftTerm/Apple/AppleTerminalView.swift
+++ b/Sources/SwiftTerm/Apple/AppleTerminalView.swift
@@ -123,6 +123,15 @@ extension TerminalView {
         return caretView?.frame ?? CGRect.zero
     }
     
+    /// FloatNote patch — scrollback depth for terminal views, in lines.
+    ///
+    /// Upstream takes `TerminalOptions`' 500-line default and rebuilds the
+    /// options object on every resize, so a client has no way to make it stick.
+    /// Set this before creating a view. 500 lines is a few seconds of Claude
+    /// Code output, and a scrollback that trims constantly is one you cannot
+    /// scroll back through.
+    public static var defaultScrollback = 500
+
     func setupOptions(width: CGFloat, height: CGFloat)
     {
         resetCaches ()
@@ -131,7 +140,8 @@ extension TerminalView {
         self.cellDimension = computeFontDimensions ()
         
         let terminalOptions = TerminalOptions(cols: Int(width / cellDimension.width),
-                                              rows: Int(height / cellDimension.height))
+                                              rows: Int(height / cellDimension.height),
+                                              scrollback: TerminalView.defaultScrollback)
         
         if terminal == nil {
             terminal = Terminal(delegate: self, options: terminalOptions)
@@ -1820,6 +1830,21 @@ extension TerminalView {
                 displayBuffer.lines.count > displayBuffer.rows
         }
     }
+
+    /// FloatNote patch — rows of output sitting below the viewport, i.e. how far
+    /// behind the live output the user currently is. 0 means pinned to the
+    /// bottom. Drives the "N lines below ↓" pill; exposed here so clients don't
+    /// need access to the buffer internals.
+    public var linesBelowViewport: Int {
+        let displayBuffer = terminal.displayBuffer
+        guard !terminal.isDisplayBufferAlternate else { return 0 }
+        return max(0, displayBuffer.yBase - displayBuffer.yDisp)
+    }
+
+    /// FloatNote patch — scroll to the newest output and resume following it.
+    public func scrollToBottom () {
+        scrollTo(row: terminal.displayBuffer.yBase)
+    }
     
     public func scroll (toPosition: Double)
     {
@@ -1846,6 +1871,20 @@ extension TerminalView {
     public func scrollTo (row: Int, notifyAccessibility: Bool = true)
     {
         let displayBuffer = terminal.displayBuffer
+        // FloatNote patch — scroll stickiness.
+        //
+        // `Terminal.scroll()` already refuses to drag the viewport down to the
+        // bottom while `Terminal.userScrolling` is set (and decrements yDisp to
+        // hold the text steady once the scrollback starts trimming), but
+        // nothing upstream ever sets that flag: the view's own `userScrolling`
+        // property is a *different* variable, touched only by
+        // `scroll(toPosition:)`. So every wheel scroll left the terminal
+        // free to snap back to the bottom on the next byte of output.
+        //
+        // Setting it here covers every scroll path — wheel, scrollbar,
+        // keyboard — because they all funnel through `scrollTo`. Landing back
+        // on the last row clears it, which is what resumes following output.
+        terminal.userScrolling = row < displayBuffer.yBase
         if row != displayBuffer.yDisp {
             terminal.setViewYDisp (row)
             
