+    /// FloatNote patch — the scrollback dropped `count` lines off the top, so
+    /// shift the selection by the same amount to keep it on the same text.
+    open func linesTrimmed(source: Terminal, count: Int) {
+        selection?.linesTrimmed(count)
+    }
+
     open func selectionChanged(source: Terminal) {
         #if canImport(MetalKit)
         if metalView != nil {
@@ -2322,13 +2328,18 @@ open class TerminalView: NSView, NSTextInputClient, NSUserInterfaceValidations,
     
     func ensureCaretIsVisible ()
     {
-        let displayBuffer = terminal.displayBuffer
-        let realCaret = displayBuffer.y + displayBuffer.yBase
-        let viewportEnd = displayBuffer.yDisp + displayBuffer.rows
-        
-        if realCaret >= viewportEnd || realCaret < displayBuffer.yDisp {
-            scrollTo (row: displayBuffer.yBase)
-        }
+        // FloatNote patch — scroll-on-input.
+        //
+        // Upstream only scrolls when the caret falls fully outside the viewport.
+        // That leaves a partial scroll-back broken: park a few lines up and the
+        // caret row is still technically inside the viewport, so typing does not
+        // return to the live screen and the characters appear to vanish. Every
+        // other terminal jumps to the bottom the moment you type, so do that —
+        // unconditionally, since `send` only runs on real input.
+        //
+        // This also clears `userScrolling` (see `scrollTo`), which is what lets
+        // output resume following after you start typing again.
+        scrollTo (row: terminal.displayBuffer.yBase)
     }
     
     public func setTerminalIconTitle(source: Terminal, title: String) {
diff --git a/Sources/SwiftTerm/SelectionService.swift b/Sources/SwiftTerm/SelectionService.swift
index 227309f..955ea21 100644
--- a/Sources/SwiftTerm/SelectionService.swift
+++ b/Sources/SwiftTerm/SelectionService.swift
@@ -84,6 +84,34 @@ class SelectionService: CustomDebugStringConvertible {
     public var isMultiLine: Bool {
         return start.row != end.row
     }
+
+    /// FloatNote patch — keep the selection on the same text when the scrollback
+    /// trims.
+    ///
+    /// `start`/`end` are indices into the line ring, so dropping `count` lines
+    /// off the top shifts every remaining line down by that much. `yDisp` is
+    /// already compensated in `Terminal.scroll()`; without the same correction
+    /// here the highlight stays on fixed row numbers and visibly walks down
+    /// through the text as output arrives. Selections that fall entirely off
+    /// the top are dropped, since the text they referred to is gone.
+    public func linesTrimmed (_ count: Int) {
+        guard count > 0, _active || hasSelectionRange else { return }
+        if end.row - count < 0 {
+            // `_active` directly, NOT `active`: the setter notifies the delegate,
+            // and this runs inside `Terminal.scroll()` with the buffer half
+            // updated. Re-entering the view's redraw from there risks losing
+            // repaints. The view redraws on the next display pass anyway.
+            _active = false
+            start = Position (col: 0, row: 0)
+            end = Position (col: 0, row: 0)
+            return
+        }
+        start = Position (col: start.col, row: max (0, start.row - count))
+        end = Position (col: end.col, row: end.row - count)
+        if let p = pivot {
+            pivot = Position (col: p.col, row: max (0, p.row - count))
+        }
+    }
     
     /**
      * Starts the selection from the specific screen-relative location
